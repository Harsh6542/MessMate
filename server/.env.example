# ==========================================
# MessMate Server Configuration
# ==========================================

# Port for Express API server
PORT=5000

# Node environment mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/messmate_dev

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Secret Key (Use a strong random string in production: openssl rand -base64 32)
JWT_SECRET=messmate_dev_jwt_secret_key_change_in_production_2026_super_secure

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Cookie Expiration in days
COOKIE_EXPIRES_IN=7

# Cloudinary Storage Configuration (Optional, for complaint image proof uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Optional, for password reset alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MessMate Alerts <no-reply@messmate.edu>
