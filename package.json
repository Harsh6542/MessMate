{
  "name": "messmate",
  "version": "1.0.0",
  "description": "Smart Hostel Mess Management & Food Waste Reduction System",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test:concurrency": "npm run test:concurrency --workspace=server",
    "install:all": "npm install --workspace=server && npm install --workspace=client"
  },
  "keywords": [
    "hostel-mess",
    "food-waste-reduction",
    "mern",
    "qr-coupon"
  ],
  "author": "",
  "license": "ISC"
}

